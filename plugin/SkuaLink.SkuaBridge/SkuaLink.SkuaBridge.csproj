<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>SkuaLink.SkuaBridge</RootNamespace>
    <AssemblyName>SkuaLink.SkuaBridge</AssemblyName>
    <SkuaLibDir Condition="'$(SkuaLibDir)' == ''">$(MSBuildThisFileDirectory)lib\skua\</SkuaLibDir>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Skua.Core.Interfaces">
      <HintPath>$(SkuaLibDir)Skua.Core.Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Skua.Core.Models">
      <HintPath>$(SkuaLibDir)Skua.Core.Models.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- The protocol is compiled in as source, never referenced, so the plugin ships as one DLL. -->
    <Compile Include="..\..\src\AqwCompanion.Skua\*.cs" LinkBase="Protocol" />
  </ItemGroup>
</Project>
