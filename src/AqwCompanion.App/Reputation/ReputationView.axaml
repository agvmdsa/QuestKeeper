<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rep="using:AqwCompanion.App.Reputation"
             x:Class="AqwCompanion.App.Reputation.ReputationView"
             x:DataType="rep:ReputationViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource AqwTextMuted}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource AqwSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AqwBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.cardHeader">
      <Setter Property="Background" Value="{DynamicResource AqwHeader}" />
      <Setter Property="Padding" Value="16,10" />
    </Style>
    <Style Selector="TextBlock.columnTitle">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AqwTextBright}" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <DataTemplate x:Key="ReputationRowTemplate" x:DataType="rep:ReputationRow">
      <Grid ColumnDefinitions="*,90,120,140" Margin="0,4">
        <TextBlock x:Name="ReputationRowName" Grid.Column="0" Text="{Binding Name}"
                   Foreground="{DynamicResource AqwTextBright}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <TextBlock x:Name="ReputationRowRank" Grid.Column="1" Text="{Binding Rank}" VerticalAlignment="Center" />
        <TextBlock x:Name="ReputationRowRep" Grid.Column="2" Text="{Binding Rep}" VerticalAlignment="Center" />
        <TextBlock x:Name="ReputationRowToNext" Grid.Column="3" Text="{Binding ToNextRank}" Classes="muted"
                   VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <!-- The list sits in the star-sized row of a grid that gets the tab's height, so its panel can virtualize. -->
  <Grid x:Name="ReputationLayout" RowDefinitions="Auto,Auto,*" Margin="16">
    <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="ReputationImportButton" Classes="primary" Content="{x:Static rep:ReputationViewModel.ImportText}"
                Command="{Binding ImportCommand}" AutomationProperties.Name="{x:Static rep:ReputationViewModel.ImportAccessibleName}" />
        <TextBlock x:Name="ReputationStatusLine" Text="{Binding StatusText}" IsVisible="{Binding HasStatus}"
                   VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.Name="{Binding StatusText}" />
      </StackPanel>
      <TextBlock x:Name="ReputationErrorLine" Text="{Binding ErrorText}" IsVisible="{Binding HasError}"
                 Foreground="{DynamicResource AqwDangerText}" TextWrapping="Wrap" AutomationProperties.Name="{Binding ErrorText}" />
      <TextBlock x:Name="ReputationImportedLine" Text="{Binding ImportedLine}" Classes="muted"
                 IsVisible="{Binding HasData}" AutomationProperties.Name="{Binding ImportedLine}" />
    </StackPanel>

    <TextBlock x:Name="ReputationEmptyState" Grid.Row="1" Grid.RowSpan="2" Text="{x:Static rep:ReputationViewModel.EmptyText}"
               TextWrapping="Wrap" VerticalAlignment="Top" IsVisible="{Binding IsEmpty}" />

    <Border x:Name="ReputationCard" Grid.Row="1" Grid.RowSpan="2" Classes="card" IsVisible="{Binding HasData}">
      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Classes="cardHeader">
          <Grid ColumnDefinitions="*,90,120,140" Margin="12,0,12,0">
            <TextBlock Grid.Column="0" Text="Faction" Classes="columnTitle" />
            <TextBlock Grid.Column="1" Text="Rank" Classes="columnTitle" />
            <TextBlock Grid.Column="2" Text="Rep" Classes="columnTitle" />
            <TextBlock Grid.Column="3" Text="To next rank" Classes="columnTitle" />
          </Grid>
        </Border>
        <ListBox x:Name="ReputationList" Grid.Row="1" ItemsSource="{Binding Items}"
                 ItemTemplate="{StaticResource ReputationRowTemplate}" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Faction standings">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>
      </Grid>
    </Border>
  </Grid>
</UserControl>
