<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AqwCompanion.App.SignIn"
        x:Class="AqwCompanion.App.SignIn.SignInWindow"
        x:DataType="vm:SignInViewModel"
        Title="{Binding WindowTitle}"
        AutomationProperties.Name="{Binding WindowTitle}"
        Icon="/Assets/app.png"
        Width="460" Height="640"
        CanResize="False"
        CanMinimize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <!-- The compact layout keeps the browser control alive at the smallest size that still lays out. -->
    <Style Selector="Border#BrowserSlot.compact">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
  </Window.Styles>
  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </Window.KeyBindings>
  <Grid RowDefinitions="Auto,*,Auto,Auto">
    <!-- Address strip: a read-only domain so the user can see where they are signing in. -->
    <Border x:Name="AddressStrip" Grid.Row="0" IsVisible="{Binding IsFull}" Padding="12,8"
            BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AqwBorder}">
      <DockPanel LastChildFill="True">
        <Button x:Name="CloseButton" DockPanel.Dock="Right" Command="{Binding CancelCommand}"
                AutomationProperties.Name="Close the sign-in window">
          <PathIcon Width="12" Height="12"
                    Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <PathIcon Width="14" Height="14"
                    Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" />
          <TextBlock x:Name="DomainText" Text="account.aq.com" VerticalAlignment="Center"
                     AutomationProperties.Name="Signing in on account.aq.com" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Border x:Name="BrowserSlot" IsVisible="{Binding ShowBrowser}" Classes.compact="{Binding IsCompact}" />
      <StackPanel x:Name="SuccessPanel" IsVisible="{Binding ShowFullSuccess}" Spacing="12"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
        <PathIcon Width="48" Height="48" HorizontalAlignment="Center" Foreground="{DynamicResource AqwSuccessText}"
                  Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
        <TextBlock Text="{Binding SuccessText}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>

    <StackPanel x:Name="StatusPanel" Grid.Row="2" IsVisible="{Binding ShowFullStatus}" Margin="16,10" Spacing="10">
      <TextBlock x:Name="StatusText" Text="{Binding Message}" TextWrapping="Wrap"
                 AutomationProperties.LiveSetting="Polite" />
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsError}">
        <Button x:Name="TryAgainButton" Content="Try again" Command="{Binding TryAgainCommand}"
                IsVisible="{Binding CanTryAgain}" AutomationProperties.Name="Try reading the character name again" />
        <Button x:Name="ErrorCloseButton" Content="Close" Command="{Binding CancelCommand}"
                AutomationProperties.Name="Close the sign-in window" />
      </StackPanel>
    </StackPanel>

    <TextBlock x:Name="PrivacyNote" Grid.Row="3" IsVisible="{Binding IsFull}" Margin="16,0,16,12" Foreground="{DynamicResource AqwTextMuted}"
               TextWrapping="Wrap"
               Text="This app only reads your character name after you sign in. Use the close button to cancel." />

    <!-- Compact layout: progress only. Declared last so it is drawn above the one-pixel browser slot's row. -->
    <StackPanel x:Name="CompactPanel" Grid.Row="0" Grid.RowSpan="4" IsVisible="{Binding IsCompact}"
                Margin="20" Spacing="12" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <PathIcon Width="18" Height="18" Foreground="{DynamicResource AqwSuccessText}" IsVisible="{Binding IsSuccess}"
                  Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
        <TextBlock x:Name="CompactTitle" Text="{Binding CompactTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
      </StackPanel>
      <ProgressBar x:Name="CompactProgress" IsIndeterminate="True" IsVisible="{Binding ShowCompactProgress}" />
      <Button x:Name="CancelButton" Content="Cancel" Command="{Binding CancelCommand}"
              IsVisible="{Binding ShowCompactProgress}" HorizontalAlignment="Right"
              AutomationProperties.Name="{Binding CancelAutomationName}" />
    </StackPanel>
  </Grid>
</Window>
