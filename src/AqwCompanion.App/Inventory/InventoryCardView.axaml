<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inventoryapp="using:AqwCompanion.App.Inventory"
             x:Class="AqwCompanion.App.Inventory.InventoryCardView"
             x:DataType="inventoryapp:InventoryCardViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="TypePreviewRow" x:DataType="x:String">
      <TextBlock Text="{Binding}" Margin="0,3" TextWrapping="Wrap" />
    </DataTemplate>
  </UserControl.Resources>

  <Border x:Name="InventoryPanel" Classes="card" Cursor="Hand">
    <StackPanel>
      <Border Classes="cardHeader">
        <TextBlock Text="Inventory" Classes="cardTitle" />
      </Border>
      <StackPanel Margin="16" Spacing="12">
        <TextBlock x:Name="InventoryStatusLine" Text="{Binding Status}" TextWrapping="Wrap"
                   IsVisible="{Binding HasStatus}" />

        <StackPanel Spacing="12" IsVisible="{Binding HasData}">
          <TextBlock x:Name="InventoryCountLine" Text="{Binding CountText}" FontSize="16"
                     FontWeight="SemiBold" Foreground="{DynamicResource AqwTextBright}" />
          <ItemsControl x:Name="InventoryTypePreviewList" ItemsSource="{Binding TypePreview}"
                        ItemTemplate="{StaticResource TypePreviewRow}" />
          <Button x:Name="ViewAllInventoryButton" Content="View all ›" Command="{Binding OpenDetailsCommand}"
                  HorizontalAlignment="Left"
                  AutomationProperties.Name="View all inventory" />
        </StackPanel>

        <TextBlock x:Name="InventoryUpdatedLine" Text="{Binding UpdatedText}" Classes="muted"
                   TextWrapping="Wrap" IsVisible="{Binding HasUpdatedText}"
                   AutomationProperties.Name="{Binding UpdatedText}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
