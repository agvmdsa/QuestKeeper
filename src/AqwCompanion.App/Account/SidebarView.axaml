<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AqwCompanion.App.Account"
             x:Class="AqwCompanion.App.Account.SidebarView"
             x:DataType="vm:SidebarViewModel">
  <UserControl.Styles>
    <!-- The sidebar slides with a short translate transition; it starts (and rests) off to the right. -->
    <Style Selector="Border#Sidebar">
      <Setter Property="RenderTransform" Value="translateX(380px)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#Sidebar.open">
      <Setter Property="RenderTransform" Value="translateX(0px)" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <!-- Scrim over the content below while the sidebar is open; clicking it closes the sidebar. -->
    <Border x:Name="Scrim" Background="{DynamicResource AqwScrim}" IsVisible="{Binding IsOpen}" />

    <!-- The details sidebar. Tab cycles inside it; it is only visible while open or sliding out. -->
    <Border x:Name="Sidebar" HorizontalAlignment="Right" Width="380" IsVisible="False"
            Background="{DynamicResource AqwSurface}" BorderBrush="{DynamicResource AqwBorder}"
            BorderThickness="1,0,0,0" KeyboardNavigation.TabNavigation="Cycle"
            AutomationProperties.Name="{Binding AutomationName}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Classes="cardHeader">
          <DockPanel>
            <Button x:Name="SidebarCloseButton" DockPanel.Dock="Right" Command="{Binding CloseCommand}"
                    Padding="8" AutomationProperties.Name="Close details">
              <PathIcon Width="12" Height="12"
                        Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
            </Button>
            <TextBlock x:Name="SidebarTitleText" Text="{Binding Title}" Classes="cardTitle"
                       VerticalAlignment="Center" />
          </DockPanel>
        </Border>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ContentControl x:Name="SidebarContentHost" Margin="16" Content="{Binding Content}" />
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
