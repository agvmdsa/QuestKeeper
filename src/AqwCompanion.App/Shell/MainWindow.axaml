<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AqwCompanion.App.Shell"
        xmlns:local="using:AqwCompanion.App"
        xmlns:hardfarms="using:AqwCompanion.App.HardFarms"
        xmlns:gamedata="using:AqwCompanion.App.GameData"
        xmlns:diagnostics="using:AqwCompanion.App.Diagnostics"
        x:Class="AqwCompanion.App.Shell.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Icon="/Assets/app.png"
        Width="1100" Height="720">
  <DockPanel>
    <!-- Plum top bar: the app name on the left, the connected character on the right. -->
    <Border x:Name="TopBar" DockPanel.Dock="Top" Background="{DynamicResource AqwTopBar}"
            BorderBrush="{DynamicResource AqwBorder}" BorderThickness="0,0,0,1" Padding="16,10">
      <DockPanel LastChildFill="False">
        <TextBlock x:Name="AppNameText" DockPanel.Dock="Left" Text="{x:Static local:AppInfo.ProductName}"
                   FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AqwOnTopBar}"
                   VerticalAlignment="Center" />
        <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="Settings" Margin="12,0,0,0" Command="{Binding ShowSettingsCommand}"
                VerticalAlignment="Center" AutomationProperties.Name="Open the settings" />
        <TextBlock x:Name="CharacterSummaryText" DockPanel.Dock="Right" Text="{Binding GameData.SelectedCharacter}"
                   IsVisible="{Binding GameData.HasCharacters}" Foreground="{DynamicResource AqwOnTopBar}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   AutomationProperties.Name="Connected character" />
      </DockPanel>
    </Border>
  <TabControl x:Name="Tabs" Padding="0">
    <TabItem Header="Hard Farms">
      <hardfarms:HardFarmsView DataContext="{Binding HardFarms}" />
    </TabItem>
    <TabItem Header="Game data">
      <gamedata:GameDataView DataContext="{Binding GameData}" />
    </TabItem>
    <TabItem Header="Diagnostics">
      <diagnostics:DiagnosticsView DataContext="{Binding Diagnostics}" />
    </TabItem>
  </TabControl>
  </DockPanel>
</Window>
