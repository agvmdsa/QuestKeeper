<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AqwCompanion.App.Account"
             xmlns:aqw="using:AqwCompanion.Core.Equipment"
             xmlns:badges="using:AqwCompanion.Core.Badges"
             x:Class="AqwCompanion.App.Account.AccountView"
             x:DataType="vm:AccountViewModel">
  <UserControl.KeyBindings>
    <!-- Works while focus is anywhere inside this view; closing is a no-op when the sidebar is already closed. -->
    <KeyBinding Gesture="Escape" Command="{Binding CloseSidebarCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource AqwSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AqwBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Width" Value="380" />
      <Setter Property="MinWidth" Value="320" />
      <Setter Property="MaxWidth" Value="420" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Border.cardHeader">
      <Setter Property="Background" Value="{DynamicResource AqwHeader}" />
      <Setter Property="Padding" Value="16,10" />
    </Style>
    <Style Selector="TextBlock.cardTitle">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AqwTextBright}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource AqwTextMuted}" />
    </Style>

    <!-- The sidebar slides with a short translate transition; it starts (and rests) off to the right. -->
    <Style Selector="Border#Sidebar">
      <Setter Property="RenderTransform" Value="translateX(380px)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#Sidebar.open">
      <Setter Property="RenderTransform" Value="translateX(0px)" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <DataTemplate x:Key="SlotRow" x:DataType="aqw:EquipmentSlot">
      <Grid ColumnDefinitions="130,*" Margin="0,3">
        <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="muted" TextWrapping="Wrap" />
        <TextBlock Grid.Column="1" Text="{Binding ItemName}" TextWrapping="Wrap" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="BadgePreviewRow" x:DataType="badges:Badge">
      <TextBlock Text="{Binding Title}" Margin="0,3" TextWrapping="Wrap" />
    </DataTemplate>

    <DataTemplate x:Key="BadgeRow" x:DataType="badges:Badge">
      <StackPanel Spacing="1" Margin="0,4">
        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource AqwTextBright}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Description}" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="BadgeGroupRow" x:DataType="badges:BadgeGroup">
      <StackPanel Spacing="4" Margin="0,0,0,8">
        <TextBlock Text="{Binding Category}" FontWeight="SemiBold" Foreground="{DynamicResource AqwAccent}"
                   TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Badges}" ItemTemplate="{StaticResource BadgeRow}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid x:Name="Root" ClipToBounds="True">
    <!-- Layer 1: the dashboard of cards. -->
    <Grid x:Name="Dashboard">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <WrapPanel Margin="16">
          <WrapPanel.Styles>
            <Style Selector="WrapPanel > Border.card">
              <Setter Property="Margin" Value="0,0,16,16" />
            </Style>
          </WrapPanel.Styles>

          <Border x:Name="AccountCard" Classes="card">
            <StackPanel>
              <Border Classes="cardHeader">
                <TextBlock Text="Account" Classes="cardTitle" />
              </Border>
              <StackPanel Margin="16" Spacing="12">
                <TextBlock x:Name="Headline" Text="{Binding Headline}" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource AqwTextBright}" TextWrapping="Wrap" />
                <TextBlock x:Name="StatusLine" Text="{Binding Status}" TextWrapping="Wrap" />
                <TextBlock x:Name="StoredDataNoticeLine" Text="{Binding StoredDataNotice}" Classes="muted"
                           TextWrapping="Wrap" IsVisible="{Binding HasStoredDataNotice}"
                           AutomationProperties.Name="{Binding StoredDataNotice}" />
                <Button x:Name="SignInButton" Content="Sign in" Classes="primary" Command="{Binding SignInCommand}"
                        IsVisible="{Binding ShowSignIn}" HorizontalAlignment="Left"
                        AutomationProperties.Name="Sign in to account.aq.com" />
                <Button x:Name="RefreshButton" Content="Refresh" Command="{Binding RefreshCommand}"
                        IsVisible="{Binding IsConnected}" HorizontalAlignment="Left"
                        AutomationProperties.Name="Refresh the character name from account.aq.com" />
                <StackPanel x:Name="ForgetPanel" Spacing="8" IsVisible="{Binding IsConnected}">
                  <Button x:Name="ForgetButton" Content="Forget stored data" Command="{Binding RequestForgetCommand}"
                          IsVisible="{Binding !IsForgetPending}" HorizontalAlignment="Left"
                          AutomationProperties.Name="Forget the data stored on this computer" />
                  <StackPanel x:Name="ForgetConfirmation" Spacing="8" IsVisible="{Binding IsForgetPending}"
                              AutomationProperties.Name="Confirm forgetting the stored data">
                    <TextBlock Text="Remove everything the app saved on this computer?" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button x:Name="ConfirmForgetButton" Content="Remove" Command="{Binding ConfirmForgetCommand}"
                              AutomationProperties.Name="Remove the stored data" />
                      <Button x:Name="CancelForgetButton" Content="Keep" Command="{Binding CancelForgetCommand}"
                              AutomationProperties.Name="Keep the stored data" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="You sign in yourself on account.aq.com. The app does not read or store your password. It reads your character name from the account home page, then loads your public character page to list what you have equipped." />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border x:Name="SummaryPanel" Classes="card" IsVisible="{Binding IsConnected}"
                  AutomationProperties.Name="Account summary">
            <StackPanel>
              <Border Classes="cardHeader">
                <TextBlock Text="Account summary" Classes="cardTitle" />
              </Border>
              <StackPanel Margin="16" Spacing="12">
                <TextBlock x:Name="SummaryUnavailableLine" Text="{x:Static vm:AccountViewModel.SummaryUnavailableText}" TextWrapping="Wrap"
                           IsVisible="{Binding !HasSummary}" />

                <StackPanel Spacing="6" IsVisible="{Binding HasSummary}">
                  <Grid ColumnDefinitions="130,*">
                    <TextBlock Grid.Column="0" Text="AdventureCoins" Classes="muted" TextWrapping="Wrap" />
                    <TextBlock x:Name="AdventureCoinsValue" Grid.Column="1" Text="{Binding AdventureCoinsText}"
                               TextWrapping="Wrap" AutomationProperties.Name="AdventureCoins" />
                  </Grid>
                  <Grid ColumnDefinitions="130,*">
                    <TextBlock Grid.Column="0" Text="Account type" Classes="muted" TextWrapping="Wrap" />
                    <TextBlock x:Name="AccountTypeValue" Grid.Column="1" Text="{Binding AccountTypeText}"
                               TextWrapping="Wrap" AutomationProperties.Name="Account type" />
                  </Grid>
                  <Grid ColumnDefinitions="130,*">
                    <TextBlock Grid.Column="0" Text="Membership" Classes="muted" TextWrapping="Wrap" />
                    <TextBlock x:Name="MembershipValue" Grid.Column="1" Text="{Binding MembershipText}"
                               TextWrapping="Wrap" AutomationProperties.Name="Membership status" />
                  </Grid>
                  <Grid ColumnDefinitions="130,*">
                    <TextBlock Grid.Column="0" Text="Gears of Doom" Classes="muted" TextWrapping="Wrap" />
                    <TextBlock x:Name="GearsOfDoomValue" Grid.Column="1" Text="{Binding GearsOfDoomText}"
                               TextWrapping="Wrap" AutomationProperties.Name="Gears of Doom" />
                  </Grid>
                </StackPanel>

                <TextBlock x:Name="SummaryUpdatedLine" Text="{Binding SummaryUpdatedText}" Classes="muted"
                           TextWrapping="Wrap" IsVisible="{Binding HasSummaryUpdatedText}"
                           AutomationProperties.Name="{Binding SummaryUpdatedText}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border x:Name="EquippedPanel" Classes="card" IsVisible="{Binding IsConnected}" Cursor="Hand">
            <StackPanel>
              <Border Classes="cardHeader">
                <TextBlock Text="Equipped" Classes="cardTitle" />
              </Border>
              <StackPanel Margin="16" Spacing="12">
                <TextBlock x:Name="EquipmentStatusLine" Text="{Binding EquipmentStatus}" TextWrapping="Wrap"
                           IsVisible="{Binding HasEquipmentStatus}" />

                <StackPanel Spacing="12" IsVisible="{Binding HasEquipment}">
                  <StackPanel Spacing="2">
                    <TextBlock x:Name="EquipmentSummaryTitle" Text="{Binding Equipment.Title}" FontSize="16"
                               FontWeight="SemiBold" Foreground="{DynamicResource AqwTextBright}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Equipment.Summary}" Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                  <ItemsControl x:Name="EquippedPreviewList" ItemsSource="{Binding EquippedPreviewSlots}"
                                ItemTemplate="{StaticResource SlotRow}" />
                  <Button x:Name="ViewAllButton" Content="View all ›" Command="{Binding OpenEquippedDetailsCommand}"
                          HorizontalAlignment="Left"
                          AutomationProperties.Name="View all equipped details" />
                </StackPanel>

                <TextBlock x:Name="EquipmentUpdatedLine" Text="{Binding EquipmentUpdatedText}" Classes="muted"
                           TextWrapping="Wrap" IsVisible="{Binding HasEquipmentUpdatedText}"
                           AutomationProperties.Name="{Binding EquipmentUpdatedText}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border x:Name="BadgesPanel" Classes="card" IsVisible="{Binding IsConnected}" Cursor="Hand">
            <StackPanel>
              <Border Classes="cardHeader">
                <TextBlock Text="Badges" Classes="cardTitle" />
              </Border>
              <StackPanel Margin="16" Spacing="12">
                <TextBlock x:Name="BadgesStatusLine" Text="{Binding BadgesStatus}" TextWrapping="Wrap"
                           IsVisible="{Binding HasBadgesStatus}" />

                <StackPanel Spacing="12" IsVisible="{Binding HasBadges}">
                  <TextBlock x:Name="BadgeCountLine" Text="{Binding BadgeCountText}" FontSize="16"
                             FontWeight="SemiBold" Foreground="{DynamicResource AqwTextBright}" />
                  <ItemsControl x:Name="BadgesPreviewList" ItemsSource="{Binding BadgesPreview}"
                                ItemTemplate="{StaticResource BadgePreviewRow}" />
                  <Button x:Name="ViewAllBadgesButton" Content="View all ›" Command="{Binding OpenBadgesDetailsCommand}"
                          HorizontalAlignment="Left"
                          AutomationProperties.Name="View all badges" />
                </StackPanel>

                <TextBlock x:Name="BadgesUpdatedLine" Text="{Binding BadgesUpdatedText}" Classes="muted"
                           TextWrapping="Wrap" IsVisible="{Binding HasBadgesUpdatedText}"
                           AutomationProperties.Name="{Binding BadgesUpdatedText}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </WrapPanel>
      </ScrollViewer>
    </Grid>

    <!-- Layer 2: scrim over the dashboard while the sidebar is open; clicking it closes the sidebar. -->
    <Border x:Name="Scrim" Background="{DynamicResource AqwScrim}" IsVisible="{Binding IsSidebarOpen}" />

    <!-- Layer 3: the details sidebar. Tab cycles inside it; it is only visible while open or sliding out. -->
    <Border x:Name="Sidebar" HorizontalAlignment="Right" Width="380" IsVisible="False"
            Background="{DynamicResource AqwSurface}" BorderBrush="{DynamicResource AqwBorder}"
            BorderThickness="1,0,0,0" KeyboardNavigation.TabNavigation="Cycle"
            AutomationProperties.Name="{Binding SidebarAutomationName}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Classes="cardHeader">
          <DockPanel>
            <Button x:Name="SidebarCloseButton" DockPanel.Dock="Right" Command="{Binding CloseSidebarCommand}"
                    Padding="8" AutomationProperties.Name="Close details">
              <PathIcon Width="12" Height="12"
                        Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
            </Button>
            <TextBlock x:Name="SidebarTitleText" Text="{Binding SidebarTitle}" Classes="cardTitle"
                       VerticalAlignment="Center" />
          </DockPanel>
        </Border>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16" Spacing="12">
            <StackPanel Spacing="12" IsVisible="{Binding IsEquippedSidebar}">
              <StackPanel Spacing="2">
                <TextBlock x:Name="EquipmentTitle" Text="{Binding Equipment.Title}" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource AqwTextBright}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Equipment.Summary}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>

              <ItemsControl x:Name="StandardSlotList" ItemsSource="{Binding Equipment.StandardSlots}"
                            ItemTemplate="{StaticResource SlotRow}" />

              <StackPanel Spacing="6" IsVisible="{Binding Equipment.HasCustomSlots}">
                <Separator Background="{DynamicResource AqwBorder}" />
                <TextBlock Text="Custom appearance" FontWeight="SemiBold" Foreground="{DynamicResource AqwTextBright}" />
                <ItemsControl x:Name="CustomSlotList" ItemsSource="{Binding Equipment.CustomSlots}"
                              ItemTemplate="{StaticResource SlotRow}" />
              </StackPanel>
            </StackPanel>

            <ItemsControl x:Name="BadgeGroupList" ItemsSource="{Binding BadgeGroups}"
                          ItemTemplate="{StaticResource BadgeGroupRow}" IsVisible="{Binding IsBadgesSidebar}" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
