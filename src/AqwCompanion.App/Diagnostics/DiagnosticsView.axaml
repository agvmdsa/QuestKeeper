<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AqwCompanion.App.Diagnostics"
             x:Class="AqwCompanion.App.Diagnostics.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">
  <StackPanel Margin="16" Spacing="12">
    <TextBlock Text="Logs are stored in:" />
    <SelectableTextBlock Text="{Binding LogDirectory}" />
    <Button Content="Export diagnostics" Command="{Binding ExportCommand}" />
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
