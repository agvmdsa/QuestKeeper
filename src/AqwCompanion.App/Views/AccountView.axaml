<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AqwCompanion.App.ViewModels"
             x:Class="AqwCompanion.App.Views.AccountView"
             x:DataType="vm:AccountViewModel">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Sign in" Command="{Binding SignInCommand}" />
        <Button Content="Open account home" Command="{Binding OpenHomeCommand}" IsVisible="{Binding IsBrowserOpen}" />
      </StackPanel>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding CharacterText}" IsVisible="{Binding HasCharacter}" FontWeight="Bold" />
      <TextBlock Opacity="0.6" TextWrapping="Wrap"
                 Text="You sign in yourself on account.aq.com. The app never sees your password; it only reads your character name from the account home page." />
    </StackPanel>
    <Border x:Name="BrowserSlot" IsVisible="{Binding IsBrowserOpen}" />
  </DockPanel>
</UserControl>
