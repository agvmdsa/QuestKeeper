<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AqwCompanion.App.CompanionApp"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Themes/AqwTheme.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Keyboard focus ring: dark brown outside, gold inside, readable on the parchment and on the lighter paper. -->
      <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#2A1208" />
      <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#F69A07" />
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <!-- Re-colors every standard control: Base* is the text/foreground ramp, Alt* the opposite ramp, Region the page. -->
        <ColorPaletteResources x:Key="Light"
                               Accent="#F69A07"
                               RegionColor="#FEF0C2"
                               ErrorText="#9B1C14"
                               AltHigh="#FEF0C2"
                               AltMediumHigh="#CCFEF0C2"
                               AltMedium="#99FEF0C2"
                               AltMediumLow="#66FEF0C2"
                               AltLow="#33FEF0C2"
                               BaseHigh="#16151A"
                               BaseMediumHigh="#E616151A"
                               BaseMedium="#CC16151A"
                               BaseMediumLow="#8016151A"
                               BaseLow="#3316151A"
                               ChromeHigh="#B88E15"
                               ChromeMediumLow="#F3E1AB"
                               ChromeMedium="#F6E8BC"
                               ChromeLow="#FEF7E1"
                               ChromeAltLow="#4F4120"
                               ChromeBlackLow="#33000000"
                               ChromeBlackMediumLow="#66000000"
                               ChromeBlackMedium="#99000000"
                               ChromeBlackHigh="#CC000000"
                               ChromeDisabledLow="#8F8460"
                               ChromeDisabledHigh="#D9C99A"
                               ChromeGray="#5C4A1F"
                               ListLow="#F6E8BC"
                               ListMedium="#F3E1AB" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource AqwWindowBackground}" />
    </Style>

    <!-- Selected tab: gold underline. Unselected tabs use the secondary text color; hovering turns them the link red. -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Foreground" Value="{DynamicResource AqwTextSecondary}" />
    </Style>
    <Style Selector="TabItem:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource AqwLink}" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource AqwTextBright}" />
    </Style>
    <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="BorderBrush" Value="{DynamicResource AqwAccent}" />
      <Setter Property="BorderThickness" Value="0,0,0,3" />
    </Style>

    <!-- Primary buttons: gold fill with dark text. -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AqwAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource AqwAccentText}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AqwAccentHover}" />
      <Setter Property="Foreground" Value="{DynamicResource AqwAccentText}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AqwAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource AqwAccentText}" />
    </Style>
  </Application.Styles>
</Application>
