<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AqwCompanion.App.ViewModels"
             x:Class="AqwCompanion.App.Views.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">
  <StackPanel Margin="16" Spacing="12">
    <TextBlock Text="Logs are stored in:" />
    <SelectableTextBlock Text="{Binding LogDirectory}" />
    <CheckBox IsChecked="{Binding IncludeSnapshot}"
              Content="Include the raw page snapshot of the last failed capture (best-effort redaction; review before sharing)" />
    <Button Content="Export diagnostics" Command="{Binding ExportCommand}" />
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
