<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:badges="using:AqwCompanion.Core.Badges"
             xmlns:badgesapp="using:AqwCompanion.App.Badges"
             x:Class="AqwCompanion.App.Badges.BadgesSidebarContent"
             x:DataType="badgesapp:BadgesCardViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="BadgeRow" x:DataType="badges:Badge">
      <StackPanel Spacing="1" Margin="0,4">
        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource AqwTextBright}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Description}" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="BadgeGroupRow" x:DataType="badges:BadgeGroup">
      <StackPanel Spacing="4" Margin="0,0,0,8">
        <TextBlock Text="{Binding Category}" FontWeight="SemiBold" Foreground="{DynamicResource AqwAccent}"
                   TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Badges}" ItemTemplate="{StaticResource BadgeRow}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <ItemsControl x:Name="BadgeGroupList" ItemsSource="{Binding Groups}"
                ItemTemplate="{StaticResource BadgeGroupRow}" />
</UserControl>
