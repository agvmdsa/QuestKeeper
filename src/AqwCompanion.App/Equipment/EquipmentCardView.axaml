<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:aqw="using:AqwCompanion.Core.Equipment"
             xmlns:equipmentapp="using:AqwCompanion.App.Equipment"
             x:Class="AqwCompanion.App.Equipment.EquipmentCardView"
             x:DataType="equipmentapp:EquipmentCardViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="SlotRow" x:DataType="aqw:EquipmentSlot">
      <Grid ColumnDefinitions="130,*" Margin="0,3">
        <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="muted" TextWrapping="Wrap" />
        <TextBlock Grid.Column="1" Text="{Binding ItemName}" TextWrapping="Wrap" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Border x:Name="EquippedPanel" Classes="card" Cursor="Hand">
    <StackPanel>
      <Border Classes="cardHeader">
        <TextBlock Text="Equipped" Classes="cardTitle" />
      </Border>
      <StackPanel Margin="16" Spacing="12">
        <TextBlock x:Name="EquipmentStatusLine" Text="{Binding Status}" TextWrapping="Wrap"
                   IsVisible="{Binding HasStatus}" />

        <StackPanel Spacing="12" IsVisible="{Binding HasData}">
          <StackPanel Spacing="2">
            <TextBlock x:Name="EquipmentSummaryTitle" Text="{Binding Data.Title}" FontSize="16"
                       FontWeight="SemiBold" Foreground="{DynamicResource AqwTextBright}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Data.Summary}" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
          <ItemsControl x:Name="EquippedPreviewList" ItemsSource="{Binding PreviewSlots}"
                        ItemTemplate="{StaticResource SlotRow}" />
          <Button x:Name="ViewAllButton" Content="View all ›" Command="{Binding OpenDetailsCommand}"
                  HorizontalAlignment="Left"
                  AutomationProperties.Name="View all equipped details" />
        </StackPanel>

        <TextBlock x:Name="EquipmentUpdatedLine" Text="{Binding UpdatedText}" Classes="muted"
                   TextWrapping="Wrap" IsVisible="{Binding HasUpdatedText}"
                   AutomationProperties.Name="{Binding UpdatedText}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
