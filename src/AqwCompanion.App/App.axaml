<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AqwCompanion.App.CompanionApp"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Themes/AqwTheme.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Keyboard focus ring: gold outside, dark inside, readable on every dark surface. -->
      <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#F69A07" />
      <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#24100D" />
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <!-- Re-colors every standard control: Base* is the text/foreground ramp, Alt* the opposite ramp, Region the page. -->
        <ColorPaletteResources x:Key="Dark"
                               Accent="#F69A07"
                               RegionColor="#24100D"
                               ErrorText="#FF7A70"
                               AltHigh="#24100D"
                               AltMediumHigh="#CC24100D"
                               AltMedium="#9924100D"
                               AltMediumLow="#6624100D"
                               AltLow="#3324100D"
                               BaseHigh="#FEF1C5"
                               BaseMediumHigh="#E6FEF1C5"
                               BaseMedium="#CCFEF1C5"
                               BaseMediumLow="#80FEF1C5"
                               BaseLow="#33FEF1C5"
                               ChromeHigh="#9A8A62"
                               ChromeMediumLow="#4A201A"
                               ChromeMedium="#381612"
                               ChromeLow="#2E130F"
                               ChromeAltLow="#D1C49E"
                               ChromeBlackLow="#33000000"
                               ChromeBlackMediumLow="#66000000"
                               ChromeBlackMedium="#99000000"
                               ChromeBlackHigh="#CC000000"
                               ChromeDisabledLow="#8A7C5C"
                               ChromeDisabledHigh="#4A3A30"
                               ChromeGray="#CDBF96"
                               ListLow="#4A201A"
                               ListMedium="#5A2D24" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource AqwWindowBackground}" />
    </Style>

    <!-- Selected tab: gold underline. Unselected tabs use the secondary text color. -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Foreground" Value="{DynamicResource AqwTextSecondary}" />
    </Style>
    <Style Selector="TabItem:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource AqwAccentHover}" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource AqwTextBright}" />
    </Style>
    <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="BorderBrush" Value="{DynamicResource AqwAccent}" />
      <Setter Property="BorderThickness" Value="0,0,0,3" />
    </Style>

    <!-- Primary buttons: gold fill with dark text. -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AqwAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource AqwAccentText}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AqwAccentHover}" />
      <Setter Property="Foreground" Value="{DynamicResource AqwAccentText}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AqwAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource AqwAccentText}" />
    </Style>
  </Application.Styles>
</Application>
