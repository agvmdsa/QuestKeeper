<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AqwCompanion.App.ViewModels"
             x:Class="AqwCompanion.App.Views.AccountView"
             x:DataType="vm:AccountViewModel">
  <Border Margin="16" Padding="20" MaxWidth="520" HorizontalAlignment="Left" VerticalAlignment="Top"
          BorderThickness="1" BorderBrush="#40808080" CornerRadius="8">
    <StackPanel Spacing="12">
      <TextBlock x:Name="Headline" Text="{Binding Headline}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
      <TextBlock x:Name="StatusLine" Text="{Binding Status}" TextWrapping="Wrap" />
      <Button x:Name="SignInButton" Content="Sign in" Command="{Binding SignInCommand}"
              IsVisible="{Binding NeedsSignIn}" HorizontalAlignment="Left"
              AutomationProperties.Name="Sign in to account.aq.com" />
      <Button x:Name="RefreshButton" Content="Refresh" Command="{Binding RefreshCommand}"
              IsVisible="{Binding IsConnected}" HorizontalAlignment="Left"
              AutomationProperties.Name="Refresh the character name from account.aq.com" />
      <TextBlock Opacity="0.6" TextWrapping="Wrap"
                 Text="You sign in yourself on account.aq.com. The app never sees your password; it only reads your character name from the account home page." />
    </StackPanel>
  </Border>
</UserControl>
