<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AqwCompanion.App.Account"
             x:Class="AqwCompanion.App.Account.SummaryCardView"
             x:DataType="vm:SummaryCardViewModel">
  <Border x:Name="SummaryPanel" Classes="card" AutomationProperties.Name="Account summary">
    <StackPanel>
      <Border Classes="cardHeader">
        <TextBlock Text="Account summary" Classes="cardTitle" />
      </Border>
      <StackPanel Margin="16" Spacing="12">
        <TextBlock x:Name="SummaryUnavailableLine" Text="{x:Static vm:SummaryCardViewModel.UnavailableText}" TextWrapping="Wrap"
                   IsVisible="{Binding !HasData}" />

        <StackPanel Spacing="6" IsVisible="{Binding HasData}">
          <Grid ColumnDefinitions="130,*">
            <TextBlock Grid.Column="0" Text="AdventureCoins" Classes="muted" TextWrapping="Wrap" />
            <TextBlock x:Name="AdventureCoinsValue" Grid.Column="1" Text="{Binding AdventureCoinsText}"
                       TextWrapping="Wrap" AutomationProperties.Name="AdventureCoins" />
          </Grid>
          <Grid ColumnDefinitions="130,*">
            <TextBlock Grid.Column="0" Text="Account type" Classes="muted" TextWrapping="Wrap" />
            <TextBlock x:Name="AccountTypeValue" Grid.Column="1" Text="{Binding AccountTypeText}"
                       TextWrapping="Wrap" AutomationProperties.Name="Account type" />
          </Grid>
          <Grid ColumnDefinitions="130,*">
            <TextBlock Grid.Column="0" Text="Membership" Classes="muted" TextWrapping="Wrap" />
            <TextBlock x:Name="MembershipValue" Grid.Column="1" Text="{Binding MembershipText}"
                       TextWrapping="Wrap" AutomationProperties.Name="Membership status" />
          </Grid>
          <Grid ColumnDefinitions="130,*">
            <TextBlock Grid.Column="0" Text="Gears of Doom" Classes="muted" TextWrapping="Wrap" />
            <TextBlock x:Name="GearsOfDoomValue" Grid.Column="1" Text="{Binding GearsOfDoomText}"
                       TextWrapping="Wrap" AutomationProperties.Name="Gears of Doom" />
          </Grid>
        </StackPanel>

        <TextBlock x:Name="SummaryUpdatedLine" Text="{Binding UpdatedText}" Classes="muted"
                   TextWrapping="Wrap" IsVisible="{Binding HasUpdatedText}"
                   AutomationProperties.Name="{Binding UpdatedText}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
