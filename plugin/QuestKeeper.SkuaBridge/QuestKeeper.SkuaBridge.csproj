<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>QuestKeeper.SkuaBridge</RootNamespace>
    <AssemblyName>QuestKeeper.SkuaBridge</AssemblyName>
    <SkuaLibDir Condition="'$(SkuaLibDir)' == ''">$(MSBuildThisFileDirectory)lib\skua\</SkuaLibDir>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Skua.Core.Interfaces">
      <HintPath>$(SkuaLibDir)Skua.Core.Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Skua.Core.Models">
      <HintPath>$(SkuaLibDir)Skua.Core.Models.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
