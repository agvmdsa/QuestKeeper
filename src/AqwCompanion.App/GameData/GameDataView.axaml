<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gd="using:AqwCompanion.App.GameData"
             x:Class="AqwCompanion.App.GameData.GameDataView"
             x:DataType="gd:GameDataViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource AqwTextMuted}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource AqwSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AqwBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.cardHeader">
      <Setter Property="Background" Value="{DynamicResource AqwHeader}" />
      <Setter Property="Padding" Value="16,10" />
    </Style>
    <!-- A slim header for the collapsed capture details, so the page keeps its room for the data. -->
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="TextBlock.columnTitle">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AqwTextBright}" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <DataTemplate x:Key="GameDataLineTemplate" x:DataType="x:String">
      <TextBlock x:Name="GameDataProfileLine" Text="{Binding}" TextWrapping="Wrap" />
    </DataTemplate>

    <DataTemplate x:Key="GameDataFactionTemplate" x:DataType="gd:GameFactionRow">
      <Grid ColumnDefinitions="*,90,120,150,120" Margin="0,4">
        <TextBlock x:Name="GameDataFactionRowName" Grid.Column="0" Text="{Binding Name}"
                   Foreground="{DynamicResource AqwTextBright}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <TextBlock x:Name="GameDataFactionRowRank" Grid.Column="1" Text="{Binding Rank}" VerticalAlignment="Center" />
        <TextBlock x:Name="GameDataFactionRowRep" Grid.Column="2" Text="{Binding Rep}" VerticalAlignment="Center" />
        <TextBlock x:Name="GameDataFactionRowProgress" Grid.Column="3" Text="{Binding Progress}" Classes="muted"
                   VerticalAlignment="Center" />
        <TextBlock x:Name="GameDataFactionRowToNext" Grid.Column="4" Text="{Binding ToNextRank}" Classes="muted"
                   VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="GameDataItemTemplate" x:DataType="gd:GameItemRow">
      <Grid ColumnDefinitions="*,130,70,50,*" Margin="0,4">
        <TextBlock x:Name="GameDataItemRowName" Grid.Column="0" Text="{Binding Name}"
                   Foreground="{DynamicResource AqwTextBright}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <TextBlock x:Name="GameDataItemRowType" Grid.Column="1" Text="{Binding Type}" Classes="muted" VerticalAlignment="Center" />
        <TextBlock x:Name="GameDataItemRowQuantity" Grid.Column="2" Text="{Binding Quantity}" VerticalAlignment="Center" />
        <TextBlock x:Name="GameDataItemRowLevel" Grid.Column="3" Text="{Binding Level}" VerticalAlignment="Center" />
        <TextBlock x:Name="GameDataItemRowFlags" Grid.Column="4" Text="{Binding Flags}" Classes="muted"
                   TextWrapping="Wrap" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer x:Name="GameDataScroll" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16" Spacing="12">
      <Border x:Name="GameDataCaptureCard" Classes="card">
        <StackPanel Margin="16,10" Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock x:Name="GameDataTitle" Text="{x:Static gd:GameDataViewModel.TitleText}" FontSize="16" Classes="columnTitle"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button x:Name="GameDataStartButton" Classes="primary" Content="{x:Static gd:GameDataViewModel.StartText}"
                    Command="{Binding StartCommand}" AutomationProperties.Name="Start the capture of the game login" />
            <Button x:Name="GameDataStopButton" Content="{x:Static gd:GameDataViewModel.StopText}"
                    Command="{Binding StopCommand}" AutomationProperties.Name="Stop the capture" />
            <Button x:Name="GameDataRestartButton" Content="{x:Static gd:GameDataViewModel.RestartText}"
                    Command="{Binding RestartAsAdministratorCommand}" IsVisible="{Binding NeedsAdministrator}"
                    AutomationProperties.Name="Restart the app as administrator" />
          </StackPanel>
          <TextBlock x:Name="GameDataStateText" Text="{Binding StateText}" TextWrapping="Wrap"
                     AutomationProperties.Name="{Binding StateText}" />
          <TextBlock x:Name="GameDataHint" Text="{Binding HintText}" Foreground="{DynamicResource AqwTextMuted}" FontSize="12"
                     TextWrapping="Wrap" IsVisible="{Binding HasHint}" AutomationProperties.Name="{Binding HintText}" />
          <SelectableTextBlock x:Name="GameDataNpcapLink" Text="{x:Static gd:GameDataViewModel.NpcapUrl}"
                               IsVisible="{Binding NpcapMissing}" Foreground="{DynamicResource AqwLink}"
                               AutomationProperties.Name="Npcap download address" />
          <Expander x:Name="GameDataCaptureDetails" Header="{x:Static gd:GameDataViewModel.CaptureDetailsText}" IsExpanded="False"
                    HorizontalAlignment="Stretch" AutomationProperties.Name="Capture details">
            <StackPanel Spacing="8" Margin="0,4,0,0">
              <Button x:Name="GameDataRefresh" Content="{x:Static gd:GameDataViewModel.RefreshText}"
                      Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh the capture numbers" />
              <TextBlock x:Name="GameDataCountersText" Text="{Binding CountersText}" Classes="muted"
                         AutomationProperties.Name="{Binding CountersText}" />
              <StackPanel Spacing="0">
                <SelectableTextBlock x:Name="GameDataDecoding" Text="{Binding DecodingText}" Foreground="{DynamicResource AqwTextMuted}" FontSize="12"
                                     TextWrapping="Wrap" IsVisible="{Binding HasDecoding}"
                                     AutomationProperties.Name="{Binding DecodingText}" />
                <SelectableTextBlock x:Name="GameDataConnections" Text="{Binding ConnectionsText}" Foreground="{DynamicResource AqwTextMuted}" FontSize="12"
                                     TextWrapping="Wrap" IsVisible="{Binding HasConnections}"
                                     AutomationProperties.Name="{Binding ConnectionsText}" />
                <SelectableTextBlock x:Name="GameDataSamples" Text="{Binding SamplesText}" Foreground="{DynamicResource AqwTextMuted}" FontSize="12"
                                     TextWrapping="Wrap" IsVisible="{Binding HasSamples}"
                                     AutomationProperties.Name="{Binding SamplesText}" />
                <SelectableTextBlock x:Name="GameDataCommands" Text="{Binding CommandsText}" Foreground="{DynamicResource AqwTextMuted}" FontSize="12"
                                     TextWrapping="Wrap" IsVisible="{Binding HasCommands}"
                                     AutomationProperties.Name="{Binding CommandsText}" />
                <SelectableTextBlock x:Name="GameDataOtherNames" Text="{Binding OtherNamesText}" Foreground="{DynamicResource AqwTextMuted}" FontSize="12"
                                     TextWrapping="Wrap" IsVisible="{Binding HasOtherNames}"
                                     AutomationProperties.Name="{Binding OtherNamesText}" />
                <SelectableTextBlock x:Name="GameDataDetails" Text="{Binding DetailsText}" Foreground="{DynamicResource AqwTextMuted}" FontSize="12"
                                     TextWrapping="Wrap" IsVisible="{Binding HasDetails}"
                                     AutomationProperties.Name="{Binding DetailsText}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsForgetPending}">
                <Button x:Name="GameDataForgetButton" Content="{x:Static gd:GameDataViewModel.ForgetText}"
                        Command="{Binding RequestForgetCommand}" AutomationProperties.Name="Forget my data" />
              </StackPanel>
              <StackPanel x:Name="GameDataForgetConfirm" Spacing="4" IsVisible="{Binding IsForgetPending}">
                <TextBlock Text="{x:Static gd:GameDataViewModel.ForgetPromptText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="GameDataForgetConfirmButton" Content="Remove" Command="{Binding ConfirmForgetCommand}"
                          AutomationProperties.Name="Confirm forgetting my data" />
                  <Button x:Name="GameDataForgetCancelButton" Content="Cancel" Command="{Binding CancelForgetCommand}"
                          AutomationProperties.Name="Cancel forgetting my data" />
                </StackPanel>
              </StackPanel>
              <TextBlock x:Name="GameDataForgetStatus" Text="{Binding ForgetStatusText}" TextWrapping="Wrap"
                         IsVisible="{Binding HasForgetStatus}" AutomationProperties.Name="{Binding ForgetStatusText}" />
            </StackPanel>
          </Expander>
          <TextBlock x:Name="GameDataPrivacyText" Text="{x:Static gd:GameDataViewModel.PrivacyText}" Classes="muted"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <TextBlock x:Name="GameDataEmptyState" Text="{x:Static gd:GameDataViewModel.EmptyText}" TextWrapping="Wrap"
                 IsVisible="{Binding !HasCharacters}" />

      <StackPanel x:Name="GameDataCharacterPanel" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasSeveralCharacters}">
        <TextBlock Text="Character" VerticalAlignment="Center" Classes="columnTitle" />
        <ComboBox x:Name="GameDataCharacterSelector" Width="240" ItemsSource="{Binding CharacterNames}"
                  SelectedItem="{Binding SelectedCharacter, Mode=TwoWay}" AutomationProperties.Name="Character" />
      </StackPanel>

      <Border x:Name="GameDataProfileCard" Classes="card" IsVisible="{Binding HasCharacters}">
        <StackPanel>
          <Border Classes="cardHeader" Padding="16,6">
            <StackPanel Spacing="0">
              <TextBlock x:Name="GameDataProfileHeadline" Text="{Binding ProfileHeadline}" Classes="columnTitle"
                         AutomationProperties.Name="{Binding ProfileHeadline}" />
              <TextBlock x:Name="GameDataCapturedText" Text="{Binding CapturedText}" Classes="muted" FontSize="11"
                         TextWrapping="Wrap" IsVisible="{Binding HasCapturedText}"
                         AutomationProperties.Name="{Binding CapturedText}" />
              <TextBlock x:Name="GameDataLiveText" Text="{Binding LiveText}" Classes="muted" FontSize="11"
                         TextWrapping="Wrap" IsVisible="{Binding HasLiveText}"
                         AutomationProperties.Name="{Binding LiveText}" />
              <TextBlock x:Name="GameDataLastGain" Text="{Binding LastGainText}" FontSize="12"
                         Foreground="{DynamicResource AqwSuccess}" TextWrapping="Wrap" IsVisible="{Binding HasLastGain}"
                         AutomationProperties.Name="{Binding LastGainText}" />
            </StackPanel>
          </Border>
          <ItemsControl x:Name="GameDataProfileList" ItemsSource="{Binding ProfileLines}" Margin="16,8"
                        ItemTemplate="{StaticResource GameDataLineTemplate}" AutomationProperties.Name="Profile" />
        </StackPanel>
      </Border>

      <Border x:Name="GameDataReputationCard" Classes="card" IsVisible="{Binding HasCharacters}">
        <StackPanel>
          <Border Classes="cardHeader">
            <Grid ColumnDefinitions="*,90,120,150,120" Margin="12,0,12,0">
              <TextBlock Grid.Column="0" Text="Faction" Classes="columnTitle" />
              <TextBlock Grid.Column="1" Text="Rank" Classes="columnTitle" />
              <TextBlock Grid.Column="2" Text="Rep" Classes="columnTitle" />
              <TextBlock Grid.Column="3" Text="Progress" Classes="columnTitle" />
              <TextBlock Grid.Column="4" Text="To next rank" Classes="columnTitle" />
            </Grid>
          </Border>
          <ItemsControl x:Name="GameDataFactionList" ItemsSource="{Binding Factions}" Margin="12,4"
                        ItemTemplate="{StaticResource GameDataFactionTemplate}" AutomationProperties.Name="Faction standings" />
        </StackPanel>
      </Border>

      <Border x:Name="GameDataInventoryCard" Classes="card" IsVisible="{Binding HasCharacters}">
        <StackPanel>
          <Border Classes="cardHeader">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBox x:Name="GameDataFilterBox" Width="240" Text="{Binding ItemFilter, Mode=TwoWay}"
                       Watermark="Filter by name" AutomationProperties.Name="Filter the captured items by name" />
              <TextBlock x:Name="GameDataItemsSummary" Text="{Binding ItemsSummary}" VerticalAlignment="Center"
                         AutomationProperties.Name="{Binding ItemsSummary}" />
            </StackPanel>
          </Border>
          <Grid ColumnDefinitions="*,130,70,50,*" Margin="28,8,12,0">
            <TextBlock Grid.Column="0" Text="Name" Classes="columnTitle" />
            <TextBlock Grid.Column="1" Text="Type" Classes="columnTitle" />
            <TextBlock Grid.Column="2" Text="Qty" Classes="columnTitle" />
            <TextBlock Grid.Column="3" Text="Lv" Classes="columnTitle" />
            <TextBlock Grid.Column="4" Text="Flags" Classes="columnTitle" />
          </Grid>
          <!-- A fixed maximum height lets the list virtualize inside the scrolling page. -->
          <ListBox x:Name="GameDataItemList" ItemsSource="{Binding Items}" MaxHeight="480"
                   ItemTemplate="{StaticResource GameDataItemTemplate}" Background="Transparent"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Captured items">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
