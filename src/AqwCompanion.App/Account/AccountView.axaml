<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AqwCompanion.App.Account"
                                       xmlns:equipmentapp="using:AqwCompanion.App.Equipment"
             xmlns:badgesapp="using:AqwCompanion.App.Badges"
             x:Class="AqwCompanion.App.Account.AccountView"
             x:DataType="vm:AccountViewModel">
  <UserControl.KeyBindings>
    <!-- Works while focus is anywhere inside this view; closing is a no-op when the sidebar is already closed. -->
    <KeyBinding Gesture="Escape" Command="{Binding Sidebar.CloseCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource AqwSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AqwBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Width" Value="380" />
      <Setter Property="MinWidth" Value="320" />
      <Setter Property="MaxWidth" Value="420" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="WrapPanel > UserControl">
      <Setter Property="Margin" Value="0,0,16,16" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Border.cardHeader">
      <Setter Property="Background" Value="{DynamicResource AqwHeader}" />
      <Setter Property="Padding" Value="16,10" />
    </Style>
    <Style Selector="TextBlock.cardTitle">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AqwTextBright}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource AqwTextMuted}" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <DataTemplate DataType="equipmentapp:EquipmentCardViewModel">
      <equipmentapp:EquipmentSidebarContent />
    </DataTemplate>

    <DataTemplate DataType="badgesapp:BadgesCardViewModel">
      <badgesapp:BadgesSidebarContent />
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid x:Name="Root" ClipToBounds="True">
    <!-- Layer 1: the dashboard of cards. -->
    <Grid x:Name="Dashboard">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <WrapPanel Margin="16">
          <WrapPanel.Styles>
            <Style Selector="WrapPanel > Border.card">
              <Setter Property="Margin" Value="0,0,16,16" />
            </Style>
          </WrapPanel.Styles>

          <Border x:Name="AccountCard" Classes="card">
            <StackPanel>
              <Border Classes="cardHeader">
                <TextBlock Text="Account" Classes="cardTitle" />
              </Border>
              <StackPanel Margin="16" Spacing="12">
                <TextBlock x:Name="Headline" Text="{Binding Headline}" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource AqwTextBright}" TextWrapping="Wrap" />
                <TextBlock x:Name="LastSyncLine" Text="{Binding LastSyncText}" Classes="muted" TextWrapping="Wrap"
                           IsVisible="{Binding HasLastSync}" AutomationProperties.Name="{Binding LastSyncText}" />
                <TextBlock x:Name="StatusLine" Text="{Binding Status}" TextWrapping="Wrap" />
                <TextBlock x:Name="StoredDataNoticeLine" Text="{Binding StoredDataNotice}" Classes="muted"
                           TextWrapping="Wrap" IsVisible="{Binding HasStoredDataNotice}"
                           AutomationProperties.Name="{Binding StoredDataNotice}" />
                <Button x:Name="SignInButton" Content="Sign in" Classes="primary" Command="{Binding SignInCommand}"
                        IsVisible="{Binding ShowSignIn}" HorizontalAlignment="Left"
                        AutomationProperties.Name="Sign in to account.aq.com" />
                <Button x:Name="RefreshButton" Content="Refresh" Command="{Binding RefreshCommand}"
                        IsVisible="{Binding IsConnected}" HorizontalAlignment="Left"
                        AutomationProperties.Name="Refresh the character name from account.aq.com" />
                <StackPanel x:Name="SignOutPanel" Spacing="8" IsVisible="{Binding IsConnected}">
                  <Button x:Name="SignOutButton" Content="Sign out" Command="{Binding RequestSignOutCommand}"
                          IsVisible="{Binding !IsSignOutPending}" HorizontalAlignment="Left"
                          AutomationProperties.Name="Sign out of account.aq.com and remove the data stored on this computer" />
                  <StackPanel x:Name="SignOutConfirmation" Spacing="8" IsVisible="{Binding IsSignOutPending}"
                              AutomationProperties.Name="Confirm signing out">
                    <TextBlock x:Name="SignOutPrompt" Text="Sign out of account.aq.com and remove everything the app saved on this computer?" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button x:Name="ConfirmSignOutButton" Content="Sign out" Command="{Binding ConfirmSignOutCommand}"
                              AutomationProperties.Name="Sign out and remove the stored data" />
                      <Button x:Name="CancelSignOutButton" Content="Keep" Command="{Binding CancelSignOutCommand}"
                              AutomationProperties.Name="Stay signed in and keep the stored data" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="You sign in yourself on account.aq.com. The app does not read or store your password. It reads your character name from the account home page, then loads your public character page to list what you have equipped." />
              </StackPanel>
            </StackPanel>
          </Border>

          <vm:SummaryCardView x:Name="SummaryCard" DataContext="{Binding Summary}" IsVisible="{Binding #Root.((vm:AccountViewModel)DataContext).IsConnected}" />
          <equipmentapp:EquipmentCardView x:Name="EquipmentCard" DataContext="{Binding Equipment}" IsVisible="{Binding #Root.((vm:AccountViewModel)DataContext).IsConnected}" />
          <badgesapp:BadgesCardView x:Name="BadgesCard" DataContext="{Binding Badges}" IsVisible="{Binding #Root.((vm:AccountViewModel)DataContext).IsConnected}" />
        </WrapPanel>
      </ScrollViewer>
    </Grid>

    <!-- Layers 2 and 3: the scrim and the details sidebar over the dashboard. -->
    <vm:SidebarView x:Name="SidebarHost" DataContext="{Binding Sidebar}" />
  </Grid>
</UserControl>
