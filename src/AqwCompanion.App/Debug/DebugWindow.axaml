<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dbg="using:AqwCompanion.App.Debug"
        xmlns:gd="using:AqwCompanion.App.GameData"
        xmlns:diagnostics="using:AqwCompanion.App.Diagnostics"
        x:Class="AqwCompanion.App.Debug.DebugWindow"
        x:DataType="dbg:DebugViewModel"
        Title="AQW Companion - debug"
        Icon="/Assets/app.png"
        Width="860" Height="620" MinWidth="560" MinHeight="360">
  <ScrollViewer x:Name="DebugScroll" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16" Spacing="12">
      <gd:CaptureDebugView x:Name="DebugCapture" DataContext="{Binding GameData}" />
      <diagnostics:DiagnosticsView x:Name="DebugDiagnostics" DataContext="{Binding Diagnostics}" />
    </StackPanel>
  </ScrollViewer>
</Window>
